# HeartLog local configuration (copy to .env; NEVER commit .env)
# All settings use the HEARTLOG_ prefix.
HEARTLOG_ENVIRONMENT=local
HEARTLOG_DEBUG=false
HEARTLOG_LOG_LEVEL=INFO

# SQLite by default. The data directory is local-only and git-ignored.
HEARTLOG_DATABASE_URL=sqlite:///./data/heartlog.db
HEARTLOG_DATA_DIR=./data
HEARTLOG_BACKUP_DIR=./backups
HEARTLOG_AUTO_CREATE_SCHEMA=true

# Optional local access control. Leave empty for a single-user local setup.
# HEARTLOG_API_TOKEN=
# Permanent deletion is disabled while HEARTLOG_ADMIN_TOKEN is empty.
# HEARTLOG_ADMIN_TOKEN=

# Limits
HEARTLOG_MAX_DIARY_CHARS=50000
HEARTLOG_MAX_CHANGE_REASON_CHARS=500
HEARTLOG_DEFAULT_PAGE_SIZE=20
HEARTLOG_MAX_PAGE_SIZE=100
HEARTLOG_MAX_EVIDENCE_CHARS=2000

# ---------------------------------------------------------------------------
# AI is OFF by default. Do not enable unless you understand what private data
# will be sent to the configured external provider. See docs/privacy.md.
#
# HEARTLOG_AI_ENABLED=false
# HEARTLOG_AI_CONSENT=false
# HEARTLOG_AI_PROVIDER=openai_compatible
# HEARTLOG_AI_BASE_URL=https://api.example.com/v1
# HEARTLOG_AI_MODEL=your-model-name
# HEARTLOG_AI_API_KEY=
# HEARTLOG_AI_TIMEOUT_SECONDS=60
# HEARTLOG_AI_MAX_OUTPUT_TOKENS=2000
# ---------------------------------------------------------------------------
